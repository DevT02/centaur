{
  "name": "centaur-vscode",
  "displayName": "The Clipboard Centaur",
  "description": "Start, review, apply, and undo AI-assisted project updates with Centaur",
  "version": "0.1.0",
  "publisher": "centaur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevT02/centaur.git"
  },
  "bugs": {
    "url": "https://github.com/DevT02/centaur/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:centaur.task",
    "onCommand:centaur.check",
    "onCommand:centaur.applyClipboard",
    "onCommand:centaur.undo",
    "onCommand:centaur.export"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "centaur.task",
        "title": "Centaur: Start an AI Task",
        "category": "Centaur",
        "icon": "$(sparkle)"
      },
      {
        "command": "centaur.applyClipboard",
        "title": "Centaur: Apply AI Update",
        "category": "Centaur",
        "icon": "$(zap)"
      },
      {
        "command": "centaur.check",
        "title": "Centaur: Check Project",
        "category": "Centaur",
        "icon": "$(pass)"
      },
      {
        "command": "centaur.undo",
        "title": "Centaur: Undo Last Change",
        "category": "Centaur",
        "icon": "$(discard)"
      },
      {
        "command": "centaur.export",
        "title": "Centaur: Export Context for AI",
        "category": "Centaur",
        "icon": "$(export)"
      }
    ],
    "keybindings": [
      {
        "command": "centaur.task",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "centaur.applyClipboard",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      },
      {
        "command": "centaur.undo",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      },
      {
        "command": "centaur.export",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ]
  }
}
